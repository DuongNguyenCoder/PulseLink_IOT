CONFIG_IDF_TARGET="esp32s3"
# The supported ESP32-S3-WROOM-1 N16R8 target has 16 MiB flash. Keep the
# image header consistent for all build profiles.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PULSELINK_FIRMWARE_VERSION="0.1.0-wifi-smoke"
CONFIG_PULSELINK_BUILD_PROFILE="default"
CONFIG_PULSELINK_WIFI_SSID=""
CONFIG_PULSELINK_WIFI_PASSWORD=""
CONFIG_PULSELINK_BACKEND_URL=""
CONFIG_PULSELINK_EVENT_ENDPOINT_URL=""
CONFIG_PULSELINK_DEVICE_TOKEN=""
CONFIG_PULSELINK_BUTTON_GPIO=4
CONFIG_PULSELINK_STATUS_LED_GPIO=-1
CONFIG_PULSELINK_COMMISSIONING_ENABLED=y
CONFIG_PULSELINK_COMMISSIONING_BUTTON_GPIO=5
CONFIG_PULSELINK_DEVICE_IDENTITY_NVS_PROVIDER=y
CONFIG_PULSELINK_OPERATIONAL_CREDENTIAL_STORAGE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
