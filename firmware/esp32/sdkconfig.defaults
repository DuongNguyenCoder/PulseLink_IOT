CONFIG_IDF_TARGET="esp32s3"
CONFIG_PULSELINK_FIRMWARE_VERSION="0.1.0-wifi-smoke"
CONFIG_PULSELINK_WIFI_SSID=""
CONFIG_PULSELINK_WIFI_PASSWORD=""
CONFIG_PULSELINK_BACKEND_URL=""
CONFIG_PULSELINK_EVENT_ENDPOINT_URL=""
CONFIG_PULSELINK_DEVICE_TOKEN=""
CONFIG_PULSELINK_BUTTON_GPIO=-1
CONFIG_PULSELINK_STATUS_LED_GPIO=-1
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
