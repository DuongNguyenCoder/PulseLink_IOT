{
  "name": "pulselink-api",
  "version": "1.0.0",
  "description": "PulseLink IoT API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run db:generate && tsc",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "test-device:create": "tsx scripts/create-test-device.ts",
    "test-recipient:prepare": "tsx scripts/prepare-test-recipient.ts",
    "test-push-token:register": "tsx scripts/register-test-push-token.ts",
    "operator:build-enrollment-request": "tsx scripts/build-device-enrollment-request.ts",
    "production:recipient:prepare": "tsx scripts/prepare-production-fcm-recipient.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "db:generate": "prisma generate",
    "db:test:up": "docker compose -f ../../infrastructure/docker/compose.test.yaml up -d postgres-test",
    "db:test:ps": "docker compose -f ../../infrastructure/docker/compose.test.yaml ps postgres-test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/nodemailer": "^8.0.2",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.5.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
