NODE_ENV=test
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
HEALTH_DIAGNOSTICS_TOKEN=<local-health-token-at-least-32-characters>
POSTGRES_PASSWORD=<development-only-password>
DATABASE_URL=postgresql://pulselink_app:<local-password>@127.0.0.1:5433/pulselink

# API authentication/runtime configuration. Use local-only key material; never commit real keys.
JWT_KEY_ID=<local-rsa-key-id>
JWT_SIGNING_KEY_PEM=<local-rsa-private-key-pem>
JWT_VERIFICATION_KEY_PEM=<local-rsa-public-key-pem>
FCM_KEY_VERSION=1
FCM_ENCRYPTION_KEY_B64=<base64-encoded-32-byte-local-key>
FCM_FINGERPRINT_KEY_B64=<base64-encoded-32-byte-local-key>
OPERATOR_ENROLLMENT_ENABLED=false
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_TIMEOUT_MS=250
LOGIN_RATE_LIMIT_BACKEND=in-memory
REDIS_URL=redis://127.0.0.1:6380
REDIS_KEY_NAMESPACE=pulselink
LOGIN_RATE_LIMIT_KEY_SECRET=<local-only-secret-at-least-32-characters>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM_EMAIL=duongbicolo@gmail.com
SMTP_FROM_NAME=PulseLink
SMTP_TIMEOUT_MS=10000
EMAIL_VERIFICATION_URL_TEMPLATE=https://app.example.com/verify-email?token={token}
PASSWORD_RESET_URL_TEMPLATE=https://app.example.com/reset-password?token={token}

# Notification worker only. Inject these values through the local environment or secret manager.
FCM_PROJECT_ID=<firebase-project-id>
FCM_CLIENT_EMAIL=<firebase-service-account-email>
FCM_PRIVATE_KEY="<firebase-private-key-with-\\n-escapes>"

# Integration tests are fail-closed and must use the canonical pulselink_test database or a pulselink_test_* database.
PULSELINK_INTEGRATION_TESTS=1
POSTGRES_TEST_PASSWORD=123456
TEST_DATABASE_URL=postgresql://pulselink_test_app:123456@127.0.0.1:5434/pulselink_test?schema=public

# Test-device script only; never use a production credential.
TEST_DEVICE_TOKEN=<local-test-token-at-least-32-characters>
