NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
POSTGRES_PASSWORD=<development-only-password>
DATABASE_URL=postgresql://pulselink_app:<local-password>@127.0.0.1:5433/pulselink

# Notification worker only. Inject these values through the local environment or secret manager.
FCM_PROJECT_ID=<firebase-project-id>
FCM_CLIENT_EMAIL=<firebase-service-account-email>
FCM_PRIVATE_KEY="<firebase-private-key-with-\\n-escapes>"

# Integration tests are fail-closed and must use the canonical pulselink_test database or a pulselink_test_* database.
PULSELINK_INTEGRATION_TESTS=0
POSTGRES_TEST_PASSWORD=123456
TEST_DATABASE_URL=postgresql://pulselink_test_app:123456@127.0.0.1:5434/pulselink_test?schema=public
